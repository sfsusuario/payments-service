# payments-service — configuración de entorno
#
# SECRET_KEY firma la cookie de sesión del panel admin.
# Genérala con: openssl rand -hex 32
SECRET_KEY=cambia-esta-clave

# Base de datos (SQLite local por defecto)
DATABASE_URL=sqlite:///./payments.db

# Las llaves Wompi y las URLs de webhook de las apps NO van aquí:
# se configuran desde el panel admin (/admin) y se guardan en la BD.
